{
  "name": "dsh-agent-growth",
  "version": "0.3.0",
  "description": "大肥鱼成长插件：让 AI 从真实素材中学习、形成选题、复盘作品并积累可追溯记忆。适用于 DeepSeek Harness，可自定义角色。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./adapters": "./adapters.js",
    "./experience": "./experience.js"
  },
  "bin": {
    "dsh-growth": "./cli.js"
  },
  "files": [
    "index.js",
    "core.js",
    "adapters.js",
    "exploration.js",
    "cli.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples",
    "README.en.md",
    "experience.js"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check core.js && node --check adapters.js && node --check exploration.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XiaoZheBrother/dsh-agent-growth.git"
  },
  "homepage": "https://github.com/XiaoZheBrother/dsh-agent-growth#readme",
  "bugs": {
    "url": "https://github.com/XiaoZheBrother/dsh-agent-growth/issues"
  }
}
